{
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": false
        },
        "clock": {
            "background": false,
            "showDate": false
        },
        "popouts": {
            "tray": true
        },
        "status": {
            "showAudio": true,
            "showBattery": false,
            "showBluetooth": true,
            "showLockStatus": false,
            "showMicrophone": false,
            "showNetwork": true,
            "showWifi": false
        },
        "tray": {
            "background": false,
            "compact": false,
            "recolour": false
        },
        "workspaces": {
            "activeTrail": false,
            "maxWindowIcons": 2,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "shown": 5
        }
    },
    "dashboard": {
        "performance": {
            "showBattery": false
        },
        "showWeather": false
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "terminal": [
                "kitty"
            ]
        }
    },
    "launcher": {
        "useFuzzy": {
            "apps": true
        }
    },
    "services": {
        "gpuType": "NVIDIA",
        "useFahrenheit": false
    },
    "sidebar": {
        "enabled": true
    }
}
