{
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "status": {
            "showAudio": true,
            "showBattery": false,
            "showLockStatus": true,
            "showMicrophone": false,
            "showWifi": false
        },
        "workspaces": {
            "activeTrail": true,
            "maxWindowIcons": 2,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "shown": 6
        }
    },
    "dashboard": {
        "performance": {
            "showBattery": false
        },
        "showWeather": false
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "terminal": [
                "kitty"
            ]
        }
    },
    "services": {
        "gpuType": "NVIDIA",
        "useFahrenheit": false
    }
}
